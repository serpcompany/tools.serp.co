# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Env files hold secrets: ignore every variant. A committed template would be
# .env.example.
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
.open-next/
out/
build
dist


# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem

next-env.d.ts

tmp/
*.tsbuildinfo
.playwright-mcp/
logs/
.wrangler/
smoke-artifacts/

# Vendored binaries that global *.gz ignores would otherwise drop.
!apps/tools/public/vendor/**/*.gz
