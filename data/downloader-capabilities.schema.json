{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tools.serp.co/schemas/downloader-capabilities.schema.json",
  "title": "Downloader capability manifest",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["route", "website", "status", "extractor", "sample_url", "last_tested_at", "last_result"],
    "properties": {
      "route": { "type": "string", "pattern": "^/download-[a-z0-9-]+-videos$" },
      "website": { "type": "string", "minLength": 1 },
      "status": {
        "type": "string",
        "enum": [
          "web_download_verified",
          "works_with_ytdlp",
          "works_with_simple_html_json_extractor",
          "needs_custom_extractor",
          "extension_only",
          "blocked_or_dead",
          "manual_review"
        ]
      },
      "extractor": { "type": "string" },
      "sample_url": { "type": "string" },
      "last_tested_at": { "type": "string" },
      "last_result": {
        "type": "object",
        "additionalProperties": true,
        "required": ["ok", "notes"],
        "properties": {
          "ok": { "type": "boolean" },
          "title_found": { "type": "boolean" },
          "formats_found": { "type": "integer", "minimum": 0 },
          "best_format": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
