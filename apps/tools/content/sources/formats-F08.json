            "note": "GIMP 2.10 introduced high-bit-depth EXR import and export.",
            "source": "https://www.gimp.org/release-notes/gimp-2.10.html"
          },
          {
            "app": "Krita",
            "note": "Loads and saves EXR for painting and interchange.",
            "source": "https://docs.krita.org/en/general_concepts/file_formats/file_exr.html"
          }
        ],
        "linux": [
          {
            "app": "GIMP",
            "note": "GIMP 2.10 introduced high-bit-depth EXR import and export.",
            "source": "https://www.gimp.org/release-notes/gimp-2.10.html"
          },
          {
            "app": "Krita",
            "note": "Loads and saves EXR for painting and interchange.",
