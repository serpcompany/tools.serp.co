{
  "formats": {
    "mts": {
      "background": [
        {
          "fact": "MTS camera recordings commonly belong to an AVCHD recording structure.",
          "source": "https://www.sony.com/electronics/support/articles/00051703"
        },
        {
          "fact": "AVCHD was designed for digital high-definition camcorders.",
          "source": "https://helpguide.sony.net/ilc/1450/v1/en/contents/TP0000226747.html"
        },
        {
          "fact": "AVCHD uses MPEG-4 AVC/H.264 compression for its video.",
          "source": "https://helpguide.sony.net/ilc/1450/v1/en/contents/TP0000226747.html"
        },
        {
          "fact": "AVCHD audio can use Dolby Digital or linear PCM.",
          "source": "https://helpguide.sony.net/ilc/1450/v1/en/contents/TP0000226747.html"
        },
        {
          "fact": "The transport-stream container and the compressed video are separate layers.",
          "source": "https://ffmpeg.org/ffmpeg-formats.html"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "VLC media player",
            "note": "Reads MPEG transport streams and decodes AVC video and AC-3 audio.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Can demux MPEG-TS input.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "mac": [
          {
            "app": "VLC media player",
            "note": "Reads MPEG transport streams and decodes AVC video and AC-3 audio.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Can demux MPEG-TS input.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "linux": [
          {
            "app": "VLC media player",
            "note": "Reads MPEG transport streams and decodes AVC video and AC-3 audio.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Can demux MPEG-TS input.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "web": [],
        "mobile": []
      },
      "problems": [
        {
          "fact": "A player needs support for the contained video and audio codecs, not just the filename ending.",
          "source": "https://ffmpeg.org/general.html"
        },
        {
          "fact": "Interlaced source material may require deinterlacing for progressive displays.",
          "source": "https://ffmpeg.org/ffmpeg-filters.html#yadif"
        },
        {
          "fact": "For archived camera material, preserve the original folder structure so the editor can import it as camera media.",
          "source": "https://support.apple.com/guide/final-cut-pro/import-from-an-archive-or-disk-image-ver41816dc2/mac"
        }
      ]
    },
    "ttf": {
      "background": [
        {
          "fact": "Apple developed TrueType and licensed the technology to Microsoft.",
          "source": "https://learn.microsoft.com/en-us/typography/truetype/history"
        },
        {
          "fact": "System 7 included TrueType in May 1991.",
          "source": "https://learn.microsoft.com/en-us/typography/truetype/history"
        },
        {
          "fact": "TrueType fonts describe scalable character outlines.",
          "source": "https://learn.microsoft.com/en-us/typography/opentype/spec/ttch01"
        },
        {
          "fact": "Font information is organized into individually tagged tables.",
          "source": "https://learn.microsoft.com/en-us/typography/opentype/spec/otff"
        },
        {
          "fact": "The font can contain glyph mappings, outlines, metrics, and naming information.",
          "source": "https://learn.microsoft.com/en-us/typography/opentype/spec/otff"
        },
        {
          "fact": "The registered media type for a TrueType font is font/ttf.",
          "source": "https://www.rfc-editor.org/rfc/rfc8081.html"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "FontForge",
            "note": "Opens TrueType outlines for editing.",
            "source": "https://fontforge.org/archive/filemenu.html"
          },
          {
            "app": "Windows Font Previewer",
            "note": "Double-click the font to inspect it before installing.",
            "source": "https://support.microsoft.com/en-us/office/fonts/download-and-install-custom-fonts-to-use-with-office"
          }
        ],
        "mac": [
          {
            "app": "Font Book",
            "note": "Installs and validates font files.",
            "source": "https://support.apple.com/guide/font-book/install-and-validate-fonts-fntbk1000/mac"
          },
          {
            "app": "FontForge",
            "note": "Edits the font outlines and tables.",
            "source": "https://fontforge.org/archive/filemenu.html"
          }
        ],
        "linux": [
          {
            "app": "FontForge",
            "note": "Loads TrueType files in its font editor.",
            "source": "https://fontforge.org/archive/filemenu.html"
          },
          {
            "app": "GNOME Fonts",
            "note": "Previews installed typefaces and installs downloaded .ttf files.",
            "source": "https://apps.gnome.org/FontViewer/"
          }
        ],
        "web": [],
        "mobile": []
      },
      "problems": [
        {
          "fact": "A damaged font can fail to display; Font Book provides file validation.",
          "source": "https://support.apple.com/guide/font-book/install-and-validate-fonts-fntbk1000/mac"
        },
        {
          "fact": "Installing two copies can create conflicts; Font Book can resolve duplicate fonts.",
          "source": "https://support.apple.com/guide/font-book/install-and-validate-fonts-fntbk1000/mac"
        },
        {
          "fact": "Fonts missing from a third-party application may require that application's own troubleshooting.",
          "source": "https://support.apple.com/guide/font-book/troubleshooting-fntb569a054a/mac"
        }
      ]
    },
    "caf": {
      "background": [
        {
          "fact": "Apple designed Core Audio Format as a flexible audio container.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Reference/CAFSpec/CAF_overview/CAF_overview.html"
        },
        {
          "fact": "CAF uses 64-bit offsets rather than the small size fields of older containers.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Reference/CAFSpec/CAF_overview/CAF_overview.html"
        },
        {
          "fact": "The container can hold compressed audio or uncompressed samples.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Reference/CAFSpec/CAF_overview/CAF_overview.html"
        },
        {
          "fact": "Its mandatory audio-description chunk identifies the stored audio encoding.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Reference/CAFSpec/CAF_spec/CAF_spec.html"
        },
        {
          "fact": "CAF supports multiple channels and optional channel-layout information.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Reference/CAFSpec/CAF_spec/CAF_spec.html"
        },
        {
          "fact": "Information and edit-comment chunks can carry descriptive text.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Reference/CAFSpec/CAF_spec/CAF_spec.html"
        },
        {
          "fact": "Core Audio support dates to OS X 10.4, with OS X 10.3 support through QuickTime 7.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Reference/CAFSpec/CAF_overview/CAF_overview.html"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "FFmpeg",
            "note": "Reads and writes Core Audio Format containers.",
            "source": "https://ffmpeg.org/general.html"
          },
          {
            "app": "ffplay",
            "note": "Uses FFmpeg demuxers and decoders to play supported CAF audio.",
            "source": "https://ffmpeg.org/ffplay.html"
          }
        ],
        "mac": [
          {
            "app": "FFmpeg",
            "note": "Reads and writes Core Audio Format containers.",
            "source": "https://ffmpeg.org/general.html"
          },
          {
            "app": "ffplay",
            "note": "Uses FFmpeg demuxers and decoders to play supported CAF audio.",
            "source": "https://ffmpeg.org/ffplay.html"
          }
        ],
        "linux": [
          {
            "app": "FFmpeg",
            "note": "Reads and writes Core Audio Format containers.",
            "source": "https://ffmpeg.org/general.html"
          },
          {
            "app": "ffplay",
            "note": "Uses FFmpeg demuxers and decoders to play supported CAF audio.",
            "source": "https://ffmpeg.org/ffplay.html"
          }
        ],
        "web": [],
        "mobile": []
      },
      "problems": [
        {
          "fact": "Opening the container does not guarantee that a system can decode its audio codec.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Conceptual/CoreAudioOverview/SupportedAudioFormatsMacOSX/SupportedAudioFormatsMacOSX.html"
        },
        {
          "fact": "Variable-packet audio needs a packet table; missing required chunk data can prevent correct decoding.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Reference/CAFSpec/CAF_spec/CAF_spec.html"
        },
        {
          "fact": "Large recordings can exceed the limits of a destination container even though CAF accommodates them.",
          "source": "https://developer.apple.com/library/archive/documentation/MusicAudio/Reference/CAFSpec/CAF_overview/CAF_overview.html"
        }
      ]
    },
    "ogv": {
      "background": [
        {
          "fact": "OGV names video content carried in an Ogg container.",
          "source": "https://www.rfc-editor.org/rfc/rfc5334.html"
        },
        {
          "fact": "The corresponding media type is video/ogg.",
          "source": "https://www.rfc-editor.org/rfc/rfc5334.html"
        },
        {
          "fact": "Ogg is maintained by the Xiph.Org Foundation.",
          "source": "https://xiph.org/ogg/"
        },
        {
          "fact": "Theora video with Vorbis sound is one documented Ogg video combination.",
          "source": "https://wiki.xiph.org/MIME_Types_and_File_Extensions"
        },
        {
          "fact": "An OGV file can include audio, video, timed text, and other visually presented content.",
          "source": "https://www.rfc-editor.org/rfc/rfc5334.html"
        },
        {
          "fact": "Ogg streams begin with the OggS identification bytes.",
          "source": "https://www.rfc-editor.org/rfc/rfc5334.html"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "VLC media player",
            "note": "Plays Ogg containers with Theora and Vorbis.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Demuxes Ogg streams for inspection and conversion.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "mac": [
          {
            "app": "VLC media player",
            "note": "Plays Ogg containers with Theora and Vorbis.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Demuxes Ogg streams for inspection and conversion.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "linux": [
          {
            "app": "VLC media player",
            "note": "Plays Ogg containers with Theora and Vorbis.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Demuxes Ogg streams for inspection and conversion.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "web": [],
        "mobile": []
      },
      "problems": [
        {
          "fact": "A player may understand Ogg while lacking a decoder for one of its streams.",
          "source": "https://wiki.xiph.org/MIME_Types_and_File_Extensions"
        },
        {
          "fact": "An Ogg file does not necessarily contain Vorbis; identifying the codec matters before conversion.",
          "source": "https://wiki.xiph.org/MIME_Types_and_File_Extensions"
        },
        {
          "fact": "The older .ogg ending is also encountered on video, although Xiph recommends .ogv for that role.",
          "source": "https://wiki.xiph.org/MIME_Types_and_File_Extensions"
        }
      ]
    },
    "pptx": {
      "background": [
        {
          "fact": "PPTX is PowerPoint's ordinary presentation document type.",
          "source": "https://support.microsoft.com/en-us/powerpoint/file-formats-that-are-supported-in-powerpoint"
        },
        {
          "fact": "PresentationML stores presentation content in an Office Open XML package.",
          "source": "https://learn.microsoft.com/en-us/office/open-xml/presentation/structure-of-a-presentationml-document"
        },
        {
          "fact": "Individual slides and their relationships occupy separate package parts.",
          "source": "https://learn.microsoft.com/en-us/office/open-xml/presentation/structure-of-a-presentationml-document"
        },
        {
          "fact": "Notes and slide masters have their own XML parts.",
          "source": "https://learn.microsoft.com/en-us/office/open-xml/presentation/structure-of-a-presentationml-document"
        },
        {
          "fact": "Macro-enabled presentations use .pptm rather than .pptx.",
          "source": "https://support.microsoft.com/en-us/powerpoint/file-formats-that-are-supported-in-powerpoint"
        },
        {
          "fact": "Its media type is application/vnd.openxmlformats-officedocument.presentationml.presentation.",
          "source": "https://help.libreoffice.org/latest/en-US/text/shared/guide/convertfilters.html"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "LibreOffice Impress",
            "note": "Includes a PowerPoint 2007\u2013365 XML filter.",
            "source": "https://help.libreoffice.org/latest/en-US/text/shared/guide/convertfilters.html"
          },
          {
            "app": "Microsoft PowerPoint",
            "note": "Opens and saves its native PPTX presentation type.",
            "source": "https://support.microsoft.com/en-us/powerpoint/file-formats-that-are-supported-in-powerpoint"
          }
        ],
        "mac": [
          {
            "app": "LibreOffice Impress",
            "note": "Imports PowerPoint presentations using its XML filters.",
            "source": "https://help.libreoffice.org/latest/en-US/text/shared/guide/convertfilters.html"
          },
          {
            "app": "Keynote",
            "note": "Open a PowerPoint presentation by dragging it to the Keynote icon.",
            "source": "https://support.apple.com/guide/keynote/open-or-close-a-presentation-tan72232b56/mac"
          },
          {
            "app": "Microsoft PowerPoint",
            "note": "Reads PPTX on macOS.",
            "source": "https://support.microsoft.com/en-us/powerpoint/file-formats-that-are-supported-in-powerpoint"
          }
        ],
        "linux": [
          {
            "app": "LibreOffice Impress",
            "note": "Provides PowerPoint XML import and export.",
            "source": "https://help.libreoffice.org/latest/en-US/text/shared/guide/convertfilters.html"
          },
          {
            "app": "ONLYOFFICE Desktop Editors",
            "note": "Opens PPTX presentations in a desktop editor available for Linux.",
            "source": "https://helpcenter.onlyoffice.com/desktop/getting-started.aspx"
          }
        ],
        "web": [
          {
            "app": "PowerPoint for the web",
            "note": "Supports PPTX presentations.",
            "source": "https://support.microsoft.com/en-us/powerpoint/file-formats-that-are-supported-in-powerpoint"
          }
        ],
        "mobile": [
          {
            "app": "Microsoft PowerPoint",
            "note": "PPTX presentations open in the mobile PowerPoint app.",
            "source": "https://support.microsoft.com/en-us/powerpoint/file-formats-that-are-supported-in-powerpoint"
          },
          {
            "app": "Keynote for iPhone",
            "note": "Opens .pptx and .ppt documents.",
            "source": "https://support.apple.com/guide/keynote-iphone/open-a-presentation-tan72232b56/ios"
          }
        ]
      },
      "problems": [
