    "exr": {
      "background": [
        {
          "fact": "OpenEXR is designed for scene-linear, high-dynamic-range imagery.",
          "source": "https://openexr.com/en/latest/"
        },
        {
          "fact": "The Academy Software Foundation hosts the OpenEXR project.",
          "source": "https://openexr.com/en/latest/"
        },
        {
          "fact": "An EXR image can contain named channels beyond red, green, blue, and alpha.",
          "source": "https://openexr.com/en/latest/TechnicalIntroduction.html"
        },
        {
          "fact": "Supported channel samples include half floats, full floats, and unsigned integers.",
          "source": "https://openexr.com/en/latest/TechnicalIntroduction.html"
        },
        {
          "fact": "The display window and the region containing stored pixels can differ.",
          "source": "https://openexr.com/en/latest/TechnicalIntroduction.html"
        },
        {
          "fact": "EXR supports scanline and tiled image layouts.",
          "source": "https://openexr.com/en/latest/TechnicalIntroduction.html"
        },
        {
          "fact": "Its uses include rendering, compositing, and texture workflows.",
          "source": "https://openexr.com/en/latest/"
        }
      ],
      "programs": {
