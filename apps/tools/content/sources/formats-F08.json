    "bin": {
      "background": [
        {
          "fact": "BIN is an extension used for raw binary output; it does not identify one universal image encoding.",
          "source": "https://sourceware.org/binutils/docs/binutils/objcopy.html"
        },
        {
          "fact": "GNU objcopy can produce a binary memory image from an object file.",
          "source": "https://sourceware.org/binutils/docs/binutils/objcopy.html"
        },
        {
          "fact": "That binary export omits symbols and relocation records.",
          "source": "https://sourceware.org/binutils/docs/binutils/objcopy.html"
        },
        {
          "fact": "Hex editors expose file bytes as hexadecimal values alongside a text view.",
          "source": "https://hexed.it/"
        },
        {
          "fact": "A binary editor can inspect bytes without interpreting them as a photograph.",
          "source": "https://www.gnu.org/software/emacs/manual/html_node/emacs/Editing-Binary-Files.html"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "GNU Emacs Hexl",
            "note": "Inspects and edits binary bytes using hexl-find-file.",
            "source": "https://www.gnu.org/software/emacs/manual/html_node/emacs/Editing-Binary-Files.html"
          },
          {
            "app": "UltraEdit",
            "note": "Provides a hex view for .bin files; this does not decode every BIN format.",
            "source": "https://www.ultraedit.com/language/hex-editor/"
          }
        ],
        "mac": [
          {
            "app": "GNU Emacs Hexl",
            "note": "Inspects and edits binary bytes using hexl-find-file.",
            "source": "https://www.gnu.org/software/emacs/manual/html_node/emacs/Editing-Binary-Files.html"
          },
          {
            "app": "UltraEdit",
            "note": "Provides a hex view for .bin files; this does not decode every BIN format.",
            "source": "https://www.ultraedit.com/language/hex-editor/"
          }
        ],
        "linux": [
          {
            "app": "GNU Emacs Hexl",
            "note": "Inspects and edits binary bytes using hexl-find-file.",
            "source": "https://www.gnu.org/software/emacs/manual/html_node/emacs/Editing-Binary-Files.html"
          },
          {
            "app": "UltraEdit",
            "note": "Provides a hex view for .bin files; this does not decode every BIN format.",
            "source": "https://www.ultraedit.com/language/hex-editor/"
          }
        ],
        "web": [
          {
            "app": "HexEd.it",
            "note": "Browser-based byte inspection and editing; it is not a universal BIN image decoder.",
            "source": "https://hexed.it/"
          }
        ],
        "mobile": []
      },
      "problems": [
        {
          "fact": "A BIN extension alone does not supply the dimensions or pixel layout required to decode raw image samples.",
          "source": "https://imagemagick.org/formats/"
        },
        {
          "fact": "Editing the wrong bytes can alter the data rather than repair a format; work on a copy when using a hex editor.",
          "source": "https://www.gnu.org/software/emacs/manual/html_node/emacs/Editing-Binary-Files.html"
        },
        {
          "fact": "An objcopy binary export cannot restore symbol information already discarded during export.",
          "source": "https://sourceware.org/binutils/docs/binutils/objcopy.html"
        }
      ]
    },
    "icns": {
      "background": [
        {
          "fact": "ICNS packages application icon artwork for macOS.",
          "source": "https://developer.apple.com/library/archive/documentation/GraphicsAnimation/Conceptual/HighResolutionOSX/Optimizing/Optimizing.html"
        },
        {
          "fact": "An icon collection can supply standard and high-resolution representations.",
          "source": "https://developer.apple.com/library/archive/documentation/GraphicsAnimation/Conceptual/HighResolutionOSX/Optimizing/Optimizing.html"
        },
        {
          "fact": "Apple documents paired icon sizes from 16 through 512 points.",
          "source": "https://developer.apple.com/library/archive/documentation/GraphicsAnimation/Conceptual/HighResolutionOSX/Optimizing/Optimizing.html"
        },
        {
          "fact": "The high-resolution 512-point representation uses a 1024-pixel image.",
          "source": "https://developer.apple.com/library/archive/documentation/GraphicsAnimation/Conceptual/HighResolutionOSX/Optimizing/Optimizing.html"
        },
        {
          "fact": "Apple's iconutil converts an iconset directory into an ICNS file.",
          "source": "https://developer.apple.com/library/archive/documentation/GraphicsAnimation/Conceptual/HighResolutionOSX/Optimizing/Optimizing.html"
        },
        {
          "fact": "The iconutil conversion also compresses the result.",
          "source": "https://developer.apple.com/library/archive/documentation/GraphicsAnimation/Conceptual/HighResolutionOSX/Optimizing/Optimizing.html"
        }
      ],
      "programs": {
        "windows": [
