    "cr3": {
      "background": [
        {
          "fact": "Canon uses the .CR3 extension for camera RAW images.",
          "source": "https://cam.start.canon/en/C004/manual/html/UG-03_Shooting-1_0030.html"
        },
        {
          "fact": "Canon identifies CR3 with EOS cameras released since 2018.",
          "source": "https://www.canon-europe.com/pro/infobank/file-numbering-and-naming/"
        },
        {
          "fact": "RAW records sensor data that needs image processing before ordinary delivery.",
          "source": "https://cam.start.canon/en/C004/manual/html/UG-03_Shooting-1_0030.html"
        },
        {
          "fact": "Compact RAW makes smaller files than the camera’s normal RAW option.",
          "source": "https://cam.start.canon/en/C004/manual/html/UG-03_Shooting-1_0030.html"
        },
        {
          "fact": "Canon says C-RAW achieves smaller files by using lossy compression.",
          "source": "https://www.canon-europe.com/pro/infobank/image-file-types/"
        },
        {
          "fact": "RAW+JPEG capture creates separate files carrying the same image number.",
          "source": "https://cam.start.canon/en/C004/manual/html/UG-03_Shooting-1_0030.html"
        },
        {
          "fact": "Processing a RAW file into JPEG can leave the original RAW unchanged.",
          "source": "https://cam.start.canon/en/C004/manual/html/UG-03_Shooting-1_0030.html"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "RawTherapee",
            "note": "CR3 decoding arrived in 5.8; that release lacked metadata support.",
            "source": "https://rawtherapee.com/downloads/5.8/"
          },
          {
            "app": "darktable",
            "note": "Added CR3 support in 3.8, with camera and dependency requirements.",
            "source": "https://www.darktable.org/2021/12/darktable-3-8/"
          },
          {
            "app": "Canon Digital Photo Professional",
            "note": "Processes supported Canon RAW images.",
            "source": "https://cam.start.canon/en/S002/manual/html/UG-00_Before_0060.html"
          }
        ],
        "mac": [
          {
            "app": "RawTherapee",
            "note": "CR3 decoding arrived in 5.8; that release lacked metadata support.",
            "source": "https://rawtherapee.com/downloads/5.8/"
          },
          {
            "app": "darktable",
            "note": "Added CR3 support in 3.8, with camera and dependency requirements.",
            "source": "https://www.darktable.org/2021/12/darktable-3-8/"
          },
          {
            "app": "Canon Digital Photo Professional",
            "note": "Processes supported Canon RAW images.",
            "source": "https://cam.start.canon/en/S002/manual/html/UG-00_Before_0060.html"
          }
        ],
        "linux": [
          {
            "app": "RawTherapee",
            "note": "CR3 decoding arrived in 5.8; that release lacked metadata support.",
            "source": "https://rawtherapee.com/downloads/5.8/"
          },
          {
            "app": "darktable",
            "note": "Added CR3 support in 3.8, with camera and dependency requirements.",
            "source": "https://www.darktable.org/2021/12/darktable-3-8/"
          }
        ],
        "web": [],
        "mobile": [
          {
            "app": "Adobe Lightroom for mobile",
            "note": "On iOS and Android, camera RAW editing requires supported camera files and premium access. Check the Canon model; Android file-picker recognition may require share-to-Lightroom or camera PTP import.",
            "source": "https://helpx.adobe.com/lightroom/mobile/get-started/supported-file-formats.html"
          }
        ]
      },
      "problems": [
        {
          "fact": "An older Digital Photo Professional build may not understand RAW files from a newer camera.",
          "source": "https://cam.start.canon/en/C004/manual/html/UG-03_Shooting-1_0030.html"
        },
        {
          "fact": "Third-party RAW support must be checked for the particular camera model.",
          "source": "https://cam.start.canon/en/C004/manual/html/UG-03_Shooting-1_0030.html"
        },
        {
          "fact": "RawTherapee 5.8 decoded CR3 pixels without CR3 metadata; its release notes describe manual input-profile selection.",
          "source": "https://rawtherapee.com/downloads/5.8/"
        }
      ]
    },
    "jxl": {
      "background": [
        {
          "fact": "JPEG XL is an image coding system developed by the JPEG committee.",
          "source": "https://jpeg.org/jpegxl/"
        },
        {
          "fact": "It offers both lossy coding and lossless coding.",
          "source": "https://jpeg.org/jpegxl/"
        },
        {
          "fact": "Its features include alpha channels, animation and progressive decoding.",
          "source": "https://jpeg.org/jpegxl/"
        },
        {
          "fact": "JPEG XL supports high bit depth, wide color gamuts and HDR.",
          "source": "https://jpeg.org/jpegxl/"
        },
        {
          "fact": "A JXL file can be a bare codestream or a box-based container.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000538.shtml"
        },
        {
          "fact": "The container can store Exif, XMP and JUMBF metadata.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000538.shtml"
        },
        {
          "fact": "The extension .jxl corresponds to the registered media type image/jxl.",
          "source": "https://www.iana.org/assignments/media-types/image/jxl"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "GIMP",
            "note": "Stable import support arrived in 2.10.32.",
            "source": "https://www.gimp.org/news/2022/06/14/gimp-2-10-32-released/"
          },
          {
            "app": "ImageMagick",
            "note": "Reads JXL with a JPEG XL delegate.",
            "source": "https://imagemagick.org/formats/"
          }
        ],
        "mac": [
          {
            "app": "GIMP",
            "note": "Stable import support arrived in 2.10.32.",
            "source": "https://www.gimp.org/news/2022/06/14/gimp-2-10-32-released/"
