{
  "formats": {
    "hevc": {
      "background": [
        {
          "fact": "HEVC is the video coding standard also named H.265 and MPEG-H Part 2.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000530.shtml"
        },
        {
          "fact": "ISO/IEC and ITU-T jointly standardized HEVC; its first publication was in 2013.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000530.shtml"
        },
        {
          "fact": "The standard addresses video storage, television, streaming and video calls.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000530.shtml"
        },
        {
          "fact": "HEVC profiles specify different combinations of coding features.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000530.shtml"
        },
        {
          "fact": "The family includes support for higher bit depths and full-resolution chroma.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000530.shtml"
        },
        {
          "fact": "A raw HEVC stream is a supported FFmpeg input, separate from a container such as MP4.",
          "source": "https://ffmpeg.org/general.html"
        },
        {
          "fact": "The video/H265 media-type registration describes HEVC carried over RTP.",
          "source": "https://www.iana.org/assignments/media-types/video/H265"
        },
        {
          "fact": "Apple introduced HEVC media support with iOS 11 and macOS High Sierra 10.13.",
          "source": "https://support.apple.com/en-us/116944"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "FFmpeg",
            "note": "Reads raw HEVC streams.",
            "source": "https://ffmpeg.org/general.html"
          },
          {
            "app": "FFplay",
            "note": "Player using FFmpeg decoding libraries.",
            "source": "https://ffmpeg.org/ffplay.html"
          }
        ],
        "mac": [
          {
            "app": "FFmpeg",
            "note": "Reads raw HEVC streams.",
            "source": "https://ffmpeg.org/general.html"
          },
          {
            "app": "FFplay",
            "note": "Player using FFmpeg decoding libraries.",
            "source": "https://ffmpeg.org/ffplay.html"
          }
        ],
        "linux": [
          {
            "app": "FFmpeg",
            "note": "Reads raw HEVC streams.",
            "source": "https://ffmpeg.org/general.html"
          },
          {
            "app": "FFplay",
            "note": "Player using FFmpeg decoding libraries.",
            "source": "https://ffmpeg.org/ffplay.html"
          }
        ],
        "web": [],
        "mobile": [
          {
            "app": "VLC for Android",
            "note": "VideoLAN documents HEVC hardware decoding through Android MediaCodec. Device capabilities and the media wrapper still matter; standalone .hevc filename handling was not separately verified.",
            "source": "https://images.videolan.org/vlc/releases/3.0.18.html"
          }
        ]
      },
      "problems": [
        {
          "fact": "A decoder must support the stream profile and level; supporting H.265 alone does not identify every decoding capability.",
          "source": "https://www.iana.org/assignments/media-types/video/H265"
        },
        {
          "fact": "Older Apple devices may be limited by the video resolution or frame rate.",
          "source": "https://support.apple.com/en-us/116944"
        },
        {
          "fact": "A raw video stream is not a general audio/video container; use a suitable wrapper when an application requires one.",
          "source": "https://ffmpeg.org/ffmpeg-formats.html"
        }
      ]
    },
    "ts": {
      "background": [
        {
          "fact": "TS identifies an MPEG-2 transport stream, one of the system formats specified by ISO/IEC 13818-1.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000635.shtml"
        },
        {
          "fact": "Transport streams multiplex separately coded video and sound rather than defining a picture codec.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000635.shtml"
        },
        {
          "fact": "A stream can carry several programs with independent clocks.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000635.shtml"
        },
        {
          "fact": "Transport-stream syntax uses timestamps to coordinate presentation and decoder buffering.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000635.shtml"
        },
        {
          "fact": "Broadcast distribution and transmissions vulnerable to errors are important uses of TS.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000635.shtml"
        },
        {
          "fact": "The usual extension is .ts and its registered media type is video/mp2t.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000635.shtml"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "VLC media player",
            "note": "Lists TS input.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Reads transport streams.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "mac": [
          {
            "app": "VLC media player",
            "note": "Lists TS input.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Reads transport streams.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "linux": [
          {
            "app": "VLC media player",
            "note": "Lists TS input.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Reads transport streams.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "web": [],
        "mobile": [
          {
            "app": "VLC for Android",
            "note": "The Android app explicitly lists TS input; decoding still depends on the media carried in the stream.",
            "source": "https://play.google.com/store/apps/details?hl=en_US&id=org.videolan.vlc"
          }
        ]
      },
      "problems": [
        {
          "fact": "Multiple programs can coexist in one stream, so selecting the intended program matters.",
          "source": "https://ffmpeg.org/ffmpeg-formats.html"
        },
        {
          "fact": "Recognizing the TS wrapper does not settle the codec required to decode its audio or video.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000635.shtml"
        },
        {
          "fact": "Transport-stream timing is part of the system format; damaged timing or missing packets cannot be fixed by changing the filename.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000635.shtml"
        }
      ]
    },
    "3gp": {
      "background": [
        {
          "fact": "3GPP defines the 3GP container as a specialization of ISO base media file format.",
          "source": "https://www.etsi.org/deliver/etsi_ts/126200_126299/126244/15.00.00_60/ts_126244v150000p.pdf"
        },
        {
          "fact": "The format supports mobile messaging, download and packet-switched streaming services.",
          "source": "https://www.etsi.org/deliver/etsi_ts/126200_126299/126244/15.00.00_60/ts_126244v150000p.pdf"
        },
        {
          "fact": "A 3GP presentation can combine video, speech, other sound and timed text.",
          "source": "https://www.rfc-editor.org/rfc/rfc3839.html"
        },
        {
          "fact": "The standard registers video coding options including H.263, MPEG-4 Visual, AVC and HEVC.",
          "source": "https://www.etsi.org/deliver/etsi_ts/126200_126299/126244/15.00.00_60/ts_126244v150000p.pdf"
        },
        {
          "fact": "Registered sound options include AMR variants and AAC.",
          "source": "https://www.etsi.org/deliver/etsi_ts/126200_126299/126244/15.00.00_60/ts_126244v150000p.pdf"
        },
        {
          "fact": "A conforming file includes a file-type box whose brands identify its profile.",
          "source": "https://www.etsi.org/deliver/etsi_ts/126200_126299/126244/15.00.00_60/ts_126244v150000p.pdf"
        },
        {
          "fact": "Use video/3gpp for visual content and audio/3gpp for purely audio content.",
          "source": "https://www.etsi.org/deliver/etsi_ts/126200_126299/126244/15.00.00_60/ts_126244v150000p.pdf"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "VLC media player",
            "note": "Lists 3GP input.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Reads 3GP containers.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "mac": [
          {
            "app": "VLC media player",
            "note": "Lists 3GP input.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Reads 3GP containers.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "linux": [
          {
            "app": "VLC media player",
            "note": "Lists 3GP input.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Reads 3GP containers.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "web": [],
        "mobile": []
      },
      "problems": [
        {
          "fact": "A file extension does not identify which of the permitted codecs a 3GP recording contains.",
          "source": "https://www.etsi.org/deliver/etsi_ts/126200_126299/126244/15.00.00_60/ts_126244v150000p.pdf"
        },
        {
          "fact": "A conforming parser may ignore boxes or codecs outside the specification.",
          "source": "https://www.etsi.org/deliver/etsi_ts/126200_126299/126244/15.00.00_60/ts_126244v150000p.pdf"
        },
        {
          "fact": "An audio-only 3GP file has no video track to recover; the format explicitly permits pure sound.",
          "source": "https://www.rfc-editor.org/rfc/rfc3839.html"
        }
      ]
    },
    "mxf": {
      "background": [
        {
          "fact": "MXF means Material Exchange Format, standardized through SMPTE documents.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000013.shtml"
        },
        {
          "fact": "It wraps media essence and associated descriptive or structural metadata.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000013.shtml"
        },
        {
          "fact": "MXF is used in professional acquisition, exchange and preservation workflows.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000013.shtml"
        },
        {
          "fact": "Its operational patterns describe arrangements of packages and essence.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000013.shtml"
        },
        {
          "fact": "The wrapper can carry different video encodings, so MXF alone does not define image quality.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000013.shtml"
        },
        {
          "fact": "Some MXF arrangements reference essence stored outside the file.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000013.shtml"
        },
        {
          "fact": "The extension is .mxf and the media type is application/mxf.",
          "source": "https://www.iana.org/assignments/media-types/application/mxf"
        }
      ],
      "programs": {
        "windows": [
          {
            "app": "VLC media player",
            "note": "Lists MXF input.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Reads MXF essence.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "mac": [
          {
            "app": "VLC media player",
            "note": "Lists MXF input.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Reads MXF essence.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "linux": [
          {
            "app": "VLC media player",
            "note": "Lists MXF input.",
            "source": "https://www.videolan.org/vlc/features.html"
          },
          {
            "app": "FFmpeg",
            "note": "Reads MXF essence.",
            "source": "https://ffmpeg.org/general.html"
          }
        ],
        "web": [],
        "mobile": []
      },
      "problems": [
        {
          "fact": "An MXF file may require a professional application because some essence structures are not arranged for ordinary playback.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000013.shtml"
        },
        {
          "fact": "Externally referenced essence can be missing when an MXF file is copied by itself.",
          "source": "https://www.loc.gov/preservation/digital/formats/fdd/fdd000013.shtml"
        },
        {
          "fact": "Changing the wrapper does not guarantee that specialized metadata or all ancillary streams will be retained.",
          "source": "https://ffmpeg.org/ffmpeg-formats.html"
        }
      ]
    },
    "cdr": {
      "background": [
        {
          "fact": "CDR is CorelDRAW’s default drawing format.",
          "source": "https://product.corel.com/help/CorelDRAW/540111147/CorelDRAW-en/CorelDRAW-Save-drawings.html"
        },
        {
          "fact": "Corel describes CDR as a primarily vector drawing format.",
          "source": "https://product.corel.com/help/PHOTO-PAINT/540111147/Corel-PHOTO-PAINT-en/Corel-PHOTO-PAINT-CorelDRAW-CDR.html"
        },
        {
          "fact": "A drawing can contain bitmap content as well as vector effects.",
          "source": "https://product.corel.com/help/CorelDRAW/540111147/CorelDRAW-en/CorelDRAW-Save-drawings.html"
        },
        {
          "fact": "CDR save options include bitmap and graphic-object compression.",
          "source": "https://product.corel.com/help/CorelDRAW/540111147/CorelDRAW-en/CorelDRAW-Save-drawings.html"
        },
        {
          "fact": "A drawing can store reference properties such as its title and subject.",
          "source": "https://product.corel.com/help/CorelDRAW/540111147/CorelDRAW-en/CorelDRAW-Save-drawings.html"
        },
        {
          "fact": "Font embedding is available, subject to font permissions and other restrictions.",
          "source": "https://product.corel.com/help/CorelDRAW/540111147/CorelDRAW-en/CorelDRAW-Save-drawings.html"
        },
        {
          "fact": "The Save As dialog offers earlier CDR versions for compatibility.",
          "source": "https://product.corel.com/help/CorelDRAW/540111147/CorelDRAW-en/CorelDRAW-Save-drawings.html"
        }
