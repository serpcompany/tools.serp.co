{
  "tools": {
    "jpg-to-pbm": {
      "methods": [
        {
          "app": "ImageMagick threshold",
          "steps": "magick scan.jpg -colorspace Gray -threshold 50% scan.pbm",
          "limits": "Explicit threshold; adjust to source; two-tone output cannot retain gray shades.",
          "source": "https://imagemagick.org/command-line-processing/",
          "supportSources": [
            "https://imagemagick.org/formats/",
            "https://imagemagick.org/command-line-options/#threshold"
          ]
        },
        {
          "app": "GIMP",
          "steps": "Open JPG; File > Export As; scan.pbm; choose ASCII or RAW in Portable Anymap export.",
          "limits": "PBM exports black and white, not continuous grayscale.",
          "source": "https://docs.gimp.org/3.2/en/file-pnm-export.html",
          "supportSources": [
            "https://docs.gimp.org/3.2/en/gimp-export-dialog.html"
          ]
        },
        {
          "app": "Netpbm pipeline",
          "steps": "jpegtopnm scan.jpg | ppmtopgm | pamthreshold -simple -threshold=0.5 | pamtopnm > scan.pbm",
          "limits": "JPEG decoder must support input; pamthreshold produces PAM, so pamtopnm is required for PBM.",
          "source": "https://netpbm.sourceforge.net/doc/pamthreshold.html",
          "supportSources": [
            "https://netpbm.sourceforge.net/doc/jpegtopnm.html",
            "https://netpbm.sourceforge.net/doc/ppmtopgm.html",
            "https://netpbm.sourceforge.net/doc/pamtopnm.html"
          ]
        }
      ]
    },
    "jpg-to-pcx": {
      "methods": [
        {
          "app": "ImageMagick",
          "steps": "magick art.jpg art.pcx",
          "limits": "No particular palette layout guaranteed by this plain command; inspect destination compatibility.",
          "source": "https://imagemagick.org/command-line-processing/",
          "supportSources": [
            "https://imagemagick.org/formats/"
          ]
        },
        {
          "app": "GIMP",
          "steps": "Open JPG; File > Export As; art.pcx.",
          "limits": "PCX export has no subsequent options dialog; prepare required image mode beforehand.",
          "source": "https://docs.gimp.org/3.2/en/file-pcx-export.html",
          "supportSources": [
            "https://docs.gimp.org/3.2/en/gimp-export-dialog.html"
          ]
        },
        {
          "app": "Pillow",
          "steps": "Python: from PIL import Image; Image.open(\"art.jpg\").save(\"art.pcx\")",
          "limits": "Pillow reads and writes PCX files holding 1, L, P or RGB data; the format comes from the file ending.",
          "source": "https://pillow.readthedocs.io/en/stable/handbook/image-file-formats.html",
          "supportSources": [
            "https://pillow.readthedocs.io/en/stable/reference/Image.html"
          ]
        }
      ]
    },
    "jpg-to-pgm": {
      "methods": [
        {
          "app": "Pillow",
          "steps": "Python: from PIL import Image; Image.open(\"photo.jpg\").convert(\"L\").save(\"photo.pgm\")",
          "limits": "Pillow converts color to L with the ITU-R 601-2 luma transform; the handbook lists PGM as readable and writable.",
          "source": "https://pillow.readthedocs.io/en/stable/reference/Image.html",
          "supportSources": [
            "https://pillow.readthedocs.io/en/stable/handbook/image-file-formats.html"
          ]
        },
        {
          "app": "Netpbm",
          "steps": "jpegtopnm photo.jpg | ppmtopgm > photo.pgm",
          "limits": "Uses documented ppmtopgm weighting; no recovery of JPEG losses.",
          "source": "https://netpbm.sourceforge.net/doc/ppmtopgm.html",
          "supportSources": [
            "https://netpbm.sourceforge.net/doc/jpegtopnm.html"
          ]
        },
        {
          "app": "GIMP",
          "steps": "Open JPG; File > Export As; photo.pgm; choose ASCII or RAW.",
          "limits": "PGM is grayscale, not color; match receiving reader storage requirements.",
          "source": "https://docs.gimp.org/3.2/en/file-pnm-export.html",
          "supportSources": [
            "https://docs.gimp.org/3.2/en/gimp-export-dialog.html"
          ]
        }
      ]
    },
    "ktx2-to-png": {
      "methods": [
        {
          "app": "KTX Software selected extraction",
          "steps": "ktx extract --level 0 --face 0 --layer 0 texture.ktx2 preview.png",
          "limits": "PNG applies to supported UNORM formats; other types may export EXR; compressed formats may need supported transcode.",
          "source": "https://github.khronos.org/KTX-Software/ktxtools/ktx_extract.html"
        },
        {
          "app": "KTX Software full extraction",
          "steps": "ktx extract --all texture.ktx2 extracted",
          "limits": "Writes separate slices, not one PNG containing the hierarchy; output format depends on internal data type.",
          "source": "https://github.khronos.org/KTX-Software/ktxtools/ktx_extract.html"
        },
        {
          "app": "PVRTexToolCLI",
          "steps": "PVRTexToolCLI -i texture.ktx2 -d preview.png -noout",
          "limits": "Requires supported internal texture codec; cubemaps/arrays produce separate named files.",
          "source": "https://docs.imgtec.com/tools-manuals/pvrtextool-manual/html/topics/cli/command-line-options.html"
        }
      ]
    },
    "mkv-to-ts": {
      "methods": [
        {
          "app": "FFmpeg H.264/AAC transcode",
          "steps": "ffmpeg -i movie.mkv -c:v libx264 -c:a aac -f mpegts movie.ts",
          "limits": "Target receiver must accept H.264/AAC; configure required parameters separately.",
          "source": "https://ffmpeg.org/ffmpeg.html",
          "supportSources": [
            "https://ffmpeg.org/ffmpeg-codecs.html",
            "https://ffmpeg.org/ffmpeg-formats.html"
          ]
        },
        {
          "app": "FFmpeg conditional mapped remux",
          "steps": "ffmpeg -i movie.mkv -map 0:v:0 -map 0:a:0 -c copy -f mpegts movie.ts",
          "limits": "Requires first video/audio streams and compatible codecs; intentionally excludes other streams.",
          "source": "https://ffmpeg.org/ffmpeg.html",
          "supportSources": [
            "https://ffmpeg.org/ffmpeg-formats.html"
          ]
        },
        {
          "app": "tsMuxer",
          "steps": "Run tsMuxeR movie.mkv; build project.meta with supported codec/file/track entries from probe; run tsMuxeR project.meta movie.ts.",
          "limits": "Compatible streams only; no transcoding. Example for H.264/AC-3: V_MPEG4/ISO/AVC, movie.mkv, track=1 and A_AC3, movie.mkv, track=2; replace track numbers with actual probe results.",
          "source": "https://github.com/justdan96/tsMuxer/blob/master/docs/USAGE.md",
          "supportSources": [
            "https://github.com/justdan96/tsMuxer"
          ]
        }
      ]
    },
    "mov-to-mjpeg": {
      "methods": [
        {
          "app": "FFmpeg MJPEG in AVI",
          "steps": "ffmpeg -i take.mov -c:a pcm_s16le -c:v mjpeg -q:v 8 take.avi",
          "limits": "AVI wrapper with PCM sound; not raw MJPEG.",
          "source": "https://ffmpeg.org/ffmpeg.html",
          "supportSources": [
            "https://ffmpeg.org/ffmpeg-codecs.html",
            "https://www.loc.gov/preservation/digital/formats/fdd/fdd000063.shtml"
          ]
        },
        {
          "app": "FFmpeg MJPEG in MOV",
          "steps": "ffmpeg -i take.mov -c:v mjpeg -q:v 3 -c:a pcm_s16le take_mjpeg.mov",
          "limits": "QuickTime wrapper with PCM sound; same encoder settings as the AVI command.",
          "source": "https://ffmpeg.org/ffmpeg-codecs.html",
          "supportSources": [
            "https://ffmpeg.org/ffmpeg.html"
          ]
        },
        {
          "app": "FFmpeg raw Motion JPEG",
          "steps": "ffmpeg -i take.mov -an -c:v mjpeg -q:v 5 -f mjpeg take.mjpeg",
          "limits": "Video-only elementary stream, deliberately different packaging from browser AVI.",
          "source": "https://ffmpeg.org/ffmpeg.html",
          "supportSources": [
            "https://ffmpeg.org/ffmpeg-formats.html"
          ]
        }
      ]
    },
    "mov-to-mxf": {
      "methods": [
        {
          "app": "FFmpeg generic MXF transcode",
          "steps": "ffmpeg -i edit.mov -codec:v mpeg2video -f mxf -ac 2 -b:v 2000k -codec:a pcm_s16le -pix_fmt yuv422p -r 25 -ar 48000 edit.mxf",
          "limits": "Generic transcode; source dimensions must be compatible; no named profile certification.",
          "source": "https://ffmpeg.org/ffmpeg.html",
          "supportSources": [
            "https://ffmpeg.org/ffmpeg-codecs.html",
            "https://ffmpeg.org/ffmpeg-formats.html"
          ]
        },
        {
          "app": "FFmpeg MXF OP-Atom",
          "steps": "ffmpeg -i take.mov -c:v mpeg2video -b:v 6M -an -f mxf_opatom take.mxf",
          "limits": "OP-Atom output here carries video only; audio needs its own file.",
          "source": "https://ffmpeg.org/ffmpeg-formats.html",
          "supportSources": [
            "https://ffmpeg.org/ffmpeg.html"
          ]
        }
      ]
    },
    "mov-to-vob": {
      "methods": [
        {
          "app": "FFmpeg NTSC DVD preset",
          "steps": "ffmpeg -i recording.mov -target ntsc-dvd recording.vob",
          "limits": "DVD media preparation only; no complete disc structure or menus.",
          "source": "https://ffmpeg.org/ffmpeg.html"
        },
        {
          "app": "FFmpeg PAL DVD preset",
          "steps": "ffmpeg -i recording.mov -target pal-dvd recording.vob",
          "limits": "Different television-standard preset; still requires authoring for a complete DVD.",
          "source": "https://ffmpeg.org/ffmpeg.html"
        }
      ]
    },
    "mp3-to-au": {
      "methods": [
        {
          "app": "FFmpeg Sun AU PCM",
          "steps": "ffmpeg -i audio.mp3 -c:a pcm_s16be -ar 44100 -ac 2 -f au audio.au",
          "limits": "Expanded PCM cannot restore original MP3 losses; receiver must accept this AU encoding.",
          "source": "https://ffmpeg.org/ffmpeg.html",
          "supportSources": [
            "https://raw.githubusercontent.com/FFmpeg/FFmpeg/master/libavformat/au.c"
          ]
        },
        {
          "app": "SoX big-endian AU",
          "steps": "sox audio.mp3 -r 44100 -c 2 -b 16 -e signed-integer -B audio.au",
          "limits": "SoX reads MP3 only when built with the MP3 libraries; AU is a standard SoX format.",
          "source": "https://manpages.debian.org/bookworm/sox/soxformat.7.en.html",
          "supportSources": [
            "https://manpages.debian.org/bookworm/sox/sox.1.en.html"
          ]
        },
        {
          "app": "Switch Sound File Converter",
          "steps": "Add the MP3; Output Format: AU; Convert.",
          "limits": "Windows program; MP3 is listed as an input and AU as an output.",
          "source": "https://help.nchsoftware.com/help/en/switch/win/generalusage.html",
          "supportSources": [
            "https://help.nchsoftware.com/help/en/switch/win/switchformats.html"
          ]
        }
      ]
    },
    "mp4-to-amr": {
      "methods": [
        {
          "app": "Switch Sound File Converter",
          "steps": "Add the MP4; Output Format: AMR; Convert.",
          "limits": "Windows program; MP4 is listed as an input and AMR as an output.",
          "source": "https://help.nchsoftware.com/help/en/switch/win/generalusage.html",
          "supportSources": [
            "https://help.nchsoftware.com/help/en/switch/win/switchformats.html"
          ]
        }
      ]
    }
  }
}
