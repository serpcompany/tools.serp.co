{
  "name": "serp-tools",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint && node scripts/validate-tools.mjs && node scripts/validate-lander-outbound-links.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "sync:network-brands": "node scripts/sync-network-brands.mjs",
    "benchmark:tools": "node scripts/benchmark-tools.mjs",
    "verify:agent-workflow": "node scripts/verify-agent-workflow.mjs",
    "lint:tools": "node scripts/validate-tools.mjs && node scripts/validate-lander-outbound-links.mjs",
    "lint:links": "node scripts/validate-lander-outbound-links.mjs"
  },
  "devDependencies": {
    "@serp-tools/eslint-config": "workspace:*",
    "@serp-tools/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20 <23"
  },
  "trustedDependencies": [
    "sharp",
    "core-js-pure"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "gifsicle",
      "sharp"
    ]
  }
}
