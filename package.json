{
  "name": "serp-tools",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm -C apps/tools cf:build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify:agent-workflow && pnpm verify:workflow-ownership && pnpm verify:docs && pnpm verify:catalog && pnpm build",
    "dev:local": "pnpm -C apps/tools dev:local",
    "test": "node scripts/run-tests.mjs",
    "lint": "TURBO_TELEMETRY_DISABLED=1 turbo lint --cache=local:rw --no-daemon",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo typecheck --cache=local:rw --no-daemon",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "artifacts:create": "node scripts/run-artifacts.mjs create --repository-root .",
    "artifacts:cleanup": "node scripts/run-artifacts.mjs cleanup --repository-root .",
    "audit:tool-coverage": "node scripts/audit-tool-coverage.mjs",
    "audit:tool-expansion-gap": "node scripts/audit-tool-expansion-gap.mjs",
    "scratch:run": "node scripts/run-with-scratch.mjs",
    "sync:extensions:check": "node scripts/fetch-store-assets.mjs --check",
    "sync:extensions:write": "node scripts/fetch-store-assets.mjs --write",
    "sync:downloader-registry:check": "node scripts/sync-downloader-landers-from-registry.mjs --check",
    "sync:downloader-registry:write": "node scripts/sync-downloader-landers-from-registry.mjs --write",
    "preview:cloudflare:local": "pnpm -C apps/tools preview:cloudflare:local",
    "prepare:cloudflare:wayfinder-preview": "pnpm -C apps/tools prepare:cloudflare:wayfinder-preview",
    "deploy:cloudflare:wayfinder-preview": "pnpm -C apps/tools deploy:cloudflare:wayfinder-preview",
    "canary:cloudflare:deployed": "pnpm -C apps/tools canary:cloudflare:deployed",
    "smoke:tools:browser": "node scripts/run-browser-check.mjs --mode smoke",
    "benchmark:tools:browser": "node scripts/run-browser-check.mjs --mode benchmark",
    "evidence:promote:tool-journeys": "node scripts/promote-tool-verification-evidence.mjs",
    "proof:tool-workflow": "node scripts/prove-tool-workflow.mjs",
    "verify:agent-workflow": "node scripts/verify-agent-workflow.mjs",
    "verify:workflow-ownership": "node scripts/verify-tool-workflow-ownership.mjs",
    "verify:docs": "node scripts/verify-documentation.mjs",
    "verify:catalog": "node scripts/validate-tools.mjs",
    "check:links": "node scripts/validate-lander-outbound-links.mjs"
  },
  "devDependencies": {
    "@serp-tools/eslint-config": "workspace:*",
    "@serp-tools/typescript-config": "workspace:*",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20 <23"
  },
  "trustedDependencies": [
    "sharp",
    "core-js-pure"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "gifsicle",
      "sharp"
    ]
  }
}
