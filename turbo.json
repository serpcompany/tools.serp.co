{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "BUILD_MODE",
    "SUPPORTS_VIDEO_CONVERSION",
    "GITHUB_TOKEN",
    "GH_TOKEN",
    "INTERNAL_DASHBOARD_TOKEN",
    "TOOL_FACTORY_CF_AUTHORIZATION",
    "DOWNLOADER_RATE_LIMIT_SECRET",
    "SERVER_ACTION_RATE_LIMIT_SECRET",
    "TOOLS_SERP_SERVER_NATIVE_PROCESSORS",
    "NEXT_PUBLIC_SITE_URL",
    "SITE_URL",
    "YTDLP_BINARY_URL",
    "YOUTUBE_DL_HOST",
    "ADSENSE_PUBLISHER_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
