#!/usr/bin/env sh
set -eu

changed_files="$(git diff --cached --name-only)"

case "$changed_files" in
  *packages/app-core/src/data/tools.json*|*scripts/validate-lander-outbound-links.mjs*|*AGENTS.md*|*README.md*)
    echo "Running lander outbound-link validation..."
    pnpm lint:links
    ;;
esac

case "$changed_files" in
  *packages/app-core/src/data/tools.json*|*apps/tools/*|*packages/app-core/*)
    echo "Running tools SOP validation..."
    node scripts/validate-tools.mjs
    ;;
esac
